# Card structure and finished-card evidence.
repo
cp good.md docs/tasks/fix-add.md
exec keel lint
stdout 'lint: 1 card\(s\), 0 with problems'

cp full-missing.md docs/tasks/fix-add.md
! exec keel lint
stdout 'missing section `## 观测面`'
stdout 'missing section `## 环境假设`'

cp unchecked.md docs/tasks/fix-add.md
! exec keel lint
stdout 'D1 has no `- 检：<kind> …` line'

cp placeholder.md docs/tasks/fix-add.md
! exec keel lint
stdout 'placeholders'

cp done-bare.md docs/tasks/fix-add.md
! exec keel lint
stdout 'needs a `RED: <commit> <filter>` line'
stdout 'needs a `GATE: <rev> ok'

cp done-partial.md docs/tasks/fix-add.md
! exec keel lint
stdout 'does not show every gate step exiting 0'

cp red-none.md docs/tasks/fix-add.md
! exec keel lint
stdout '`RED: none` is not allowed on a `fix` card'

cp author.md docs/tasks/fix-add.md
! exec keel lint
stdout 'author check is not confirmed'

cp good.md docs/tasks/feat-add.md
! exec keel lint docs/tasks/feat-add.md
stdout 'file name must be `fix-<kebab-slug>.md`'

