#!/bin/sh
# Conventional Commits: type(scope)!: subject — the subject says why, in the imperative.
first=$(head -n1 "$1")
case "$first" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac
if ! printf '%s\n' "$first" | grep -Eq '^(feat|fix|perf|refactor|test|docs|chore|build|ci|style|revert)(\([a-z0-9._/-]+\))?!?: .+'; then
  echo "commit-msg: expected 'type(scope): subject' (Conventional Commits), got:" >&2
  echo "  $first" >&2
  exit 1
fi
